# 这是 .env 的脱敏模板:字段名齐全,密钥位置留空。
# 真正要跑起来,复制成 .env 再把值填上 —— .env 已被 .gitignore 挡住,不会进仓库。

#模型相关配置
ANTHROPIC_API_KEY=
MODEL_ID=deepseek-flash
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

#skill路径配置
SKILL_DIR=SKILLS

#单次工具调用结果限制
MAX_RESULT_LIMIT= 2000
#工具调用结果保存路径
TOOL_RESULT_PATH= tool_result
#压缩消息保存路径
TRANSCRIPT= transcript
#消息数量限制
MAX_MESSAGES= 50
#上下文限制
CONTEXT_LIMIT= 200000
#记忆目录配置
MEMORY_DIR= memory
